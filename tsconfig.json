{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "rootDir": "TypescriptExercise/EmployeesDataManipolation",
    "outDir": "dist",
    "strict": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["TypescriptExercise/EmployeesDataManipolation/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
